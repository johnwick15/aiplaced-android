+    fun changeAvailability(target: Boolean) {
+        if (busy) return
+        val previous = dashboard ?: return
+        busy = true
+        error = ""
+        dashboard = previous.copy(worker = previous.worker.copy(available = target))
+        scope.launch {
+            try {
+                val msg = api.setAvailability(target)
+                dashboard = api.workerDashboard()
+                Toast.makeText(
+                    context,
+                    msg.ifBlank { if (target) "You're online." else "You're offline." },
+                    Toast.LENGTH_SHORT
+                ).show()
+            } catch (e: Exception) {
+                dashboard = previous
+                val message = e.message ?: "Could not update your status."
+                error = message
+                Toast.makeText(context, message, Toast.LENGTH_LONG).show()
+            } finally {
+                busy = false
+            }
+        }
+    }
